# Optional: Set your custom production domain (if omitted, Vercel URL is detected automatically)
# NEXT_PUBLIC_SITE_URL=https://iqbal-portfolio.vercel.app

# Optional: Google Search Console verification token (content value from HTML meta tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=

# Optional: Upstash Redis REST credentials if you prefer private Redis for the footer visitor counter
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
